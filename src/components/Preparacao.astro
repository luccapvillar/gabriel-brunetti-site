---
import Foto from './Foto.astro';
import Rotulo from './Rotulo.astro';

// Frequências confirmadas pelo piloto. O simulador é "toda semana" (frequência exata não informada).
const frentes = [
  {
    valor: 5,
    unidade: '×',
    quando: 'por semana',
    nome: 'Academia',
    funcao: 'Preparo físico. No kart, pescoço, braços e tronco seguram o corpo em cada curva e em cada freada, do começo ao fim da prova.',
  },
  {
    valor: 2,
    unidade: '×',
    quando: 'por semana',
    nome: 'Kart',
    funcao: 'Tempo de pista. É onde o traçado, o acerto do kart e a leitura da pista viram prática.',
  },
  {
    valor: null,
    unidade: '',
    quando: 'Toda semana',
    nome: 'Simulador',
    funcao: 'Repetição de traçado. Volta após volta, para chegar ao kartódromo com as referências na cabeça.',
  },
];
---

<section class="preparacao secao" id="preparacao" aria-labelledby="titulo-preparacao">
  <div class="conteiner">
    <div class="preparacao__topo">
      <div>
        <Rotulo numero="05" nome="Preparação" />
        <h2 class="h2" id="titulo-preparacao">O que acontece entre uma corrida e outra</h2>
      </div>
      <figure class="preparacao__foto" data-revelar>
        <Foto
          nome="curva-cabeca-baixa"
          alt="Gabriel numa curva, de cabeça baixa e corpo inclinado, segurando o kart."
          sizes="(min-width: 1024px) 40vw, 100vw"
        />
      </figure>
    </div>

    <ol class="frentes">
      {
        frentes.map((f, i) => (
          <li data-revelar style={`--atraso:${i * 0.08}s`}>
            <p class="frentes__numero">
              {f.valor !== null ? (
                <span class="frentes__valor">
                  <span data-contador={f.valor}>{f.valor}</span>
                  {f.unidade}
                </span>
              ) : (
                <span class="frentes__palavra">Toda semana</span>
              )}
              <span class="frentes__quando mono">{f.valor !== null ? f.quando : '\u00a0'}</span>
            </p>
            <h3 class="h3">{f.nome}</h3>
            <p class="texto-2">{f.funcao}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .preparacao__topo {
    display: grid;
    gap: 40px;
    align-items: end;
  }

  .preparacao__foto :global(img) {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--raio);
  }

  .frentes {
    display: grid;
    margin-top: clamp(56px, 8vw, 112px);
    border-top: 1px solid var(--linha-clara);
  }

  .frentes li {
    padding-block: 28px 32px;
    border-bottom: 1px solid var(--linha-clara);
  }

  .frentes__numero {
    display: grid;
    grid-template-rows: clamp(4rem, 2.6rem + 5vw, 6.75rem) auto;
    align-items: end;
    gap: 12px;
    margin-bottom: 24px;
    color: var(--verde-claro);
  }

  .frentes__valor,
  .frentes__palavra {
    font-family: var(--fonte-titulo);
    font-weight: 820;
    line-height: 0.82;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }

  .frentes__valor {
    font-size: clamp(4.5rem, 3rem + 5.5vw, 8rem);
  }

  .frentes__palavra {
    font-size: clamp(2.25rem, 1.6rem + 2.4vw, 3.5rem);
    letter-spacing: -0.03em;
    line-height: 0.95;
  }

  .frentes__quando {
    color: var(--texto-claro-2);
  }

  .frentes h3 {
    margin-bottom: 10px;
  }

  .frentes .texto-2 {
    max-width: 26em;
  }

  @media (min-width: 768px) {
    .frentes {
      grid-template-columns: repeat(3, 1fr);
      border-bottom: 1px solid var(--linha-clara);
    }

    .frentes li {
      border-bottom: 0;
      padding-right: 28px;
      display: grid;
      grid-template-rows: 1fr auto auto;
    }

    .frentes li + li {
      border-left: 1px solid var(--linha-clara);
      padding-left: 28px;
    }
  }

  @media (min-width: 1024px) {
    .preparacao__topo {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: clamp(48px, 6vw, 112px);
    }
  }
</style>
