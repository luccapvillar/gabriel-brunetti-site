---
/**
 * Parcerias: por que agora (só fatos), patrocinadora atual, mapa de exposição sobre zebra.jpg e CTA.
 * Pontos do mapa em % da foto (2560×1706), conferidos sobre a imagem.
 */
import Foto from './Foto.astro';
import Rotulo from './Rotulo.astro';
import { contato } from '../data/gabriel';

const motivos = [
  'Duas competições na temporada: Campeonato Brasiliense e Campeonato Brasileiro.',
  '2º lugar em três etapas do BKS 2026.',
  'Academia 5× por semana, kart 2× por semana e simulador toda semana.',
  'Plano de correr em diferentes estados do Brasil.',
  'Equipe Dibo Racing e família envolvida no projeto.',
];

const pontos = [
  { x: 55, y: 27, nome: 'Capacete', texto: 'O ponto mais alto do conjunto, visível de qualquer ângulo.' },
  { x: 41.5, y: 44.5, nome: 'Painel frontal', texto: 'Acima do número, na frente do kart.' },
  { x: 65.5, y: 47, nome: 'Macacão', texto: 'Tronco, braços e pernas do piloto.' },
  { x: 23.5, y: 74, nome: 'Bico e carenagem frontal', texto: 'A parte mais baixa e à frente do kart.' },
  { x: 78, y: 69.5, nome: 'Laterais', texto: 'Junto da placa 33, dos dois lados do kart.' },
];
---

<section class="parcerias secao" id="parcerias" aria-labelledby="titulo-parcerias">
  <div class="conteiner">
    <div class="parcerias__topo">
      <div>
        <Rotulo numero="08" nome="Parcerias" />
        <h2 class="h2" id="titulo-parcerias">Uma marca no #33 desde as primeiras temporadas</h2>
      </div>

      <div class="atual" data-revelar>
        <p class="mono atual__rotulo">Patrocinadora atual</p>
        <p class="atual__nome">Brunetti Odontologia</p>
        <p class="atual__onde">Nas laterais e no bico do kart.</p>
      </div>
    </div>

    <div class="motivos">
      <h3 class="mono motivos__titulo">Por que agora</h3>
      <ol>
        {
          motivos.map((m, i) => (
            <li data-revelar style={`--atraso:${i * 0.06}s`}>
              <span class="mono">{String(i + 1).padStart(2, '0')}</span>
              <p>{m}</p>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="mapa">
      <div class="mapa__cabeca">
        <h3 class="h3">Onde uma marca aparece</h3>
        <p class="mapa__dica texto-2">Toque nos pontos para ver cada espaço.</p>
      </div>

      <div class="mapa__foto" data-mapa>
        <Foto
          nome="zebra"
          alt="Gabriel sobre a zebra numa curva à direita, com o kart inteiro à vista: bico, painel frontal, laterais, capacete e macacão."
          sizes="(min-width: 1440px) 1440px, 100vw"
        />
        {
          pontos.map((p, i) => (
            <button
              type="button"
              class="mapa__ponto"
              style={`left:${p.x}%;top:${p.y}%`}
              aria-describedby={`ponto-${i}`}
              aria-expanded="false"
              data-ponto={i}
            >
              <span aria-hidden="true">{i + 1}</span>
              <span class="visualmente-oculto">{p.nome}</span>
            </button>
          ))
        }
      </div>

      <div class="mapa__lista">
        <ol>
          {
            pontos.map((p, i) => (
              <li id={`ponto-${i}`} data-ponto-item={i}>
                <span class="mapa__num" aria-hidden="true">{i + 1}</span>
                <span>
                  <strong>{p.nome}</strong>
                  <span class="texto-2">{p.texto}</span>
                </span>
              </li>
            ))
          }
        </ol>
        <div class="mapa__digital">
          <p class="mono">No digital</p>
          <ul>
            <li>
              <strong>Instagram</strong>
              <a href={contato.instagramUrl} rel="noopener" target="_blank">{contato.instagram}</a>
            </li>
            <li>
              <strong>Este site</strong>
              <span class="texto-2">Nesta seção, ao lado da patrocinadora atual.</span>
            </li>
          </ul>
        </div>
      </div>
      <p class="mapa__nota">Espaços e formatos são definidos em conversa.</p>
    </div>

    <div class="cta" data-revelar>
      <p class="cta__texto">
        Para conversar sobre patrocínio, escreva por e-mail ou chame no WhatsApp.
      </p>
      <div class="cta__botoes">
        <a class="botao" href={contato.emailPatrocinio}>
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3.5 6.5 8.5 7 8.5-7" /></svg>
          Enviar e-mail
        </a>
        <a class="botao botao--linha" href={contato.whatsapp} rel="noopener" target="_blank">
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.2c0-.1-.2-.2-.5-.3Z" /></svg>
          Conversar no WhatsApp
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .parcerias {
    background: var(--verde-profundo);
  }

  .parcerias .rotulo,
  .parcerias .texto-2 {
    color: rgb(242 240 234 / 0.78);
  }

  .parcerias__topo {
    display: grid;
    gap: 40px;
    align-items: end;
  }

  .parcerias .h2 {
    max-width: 18ch;
  }

  .atual {
    padding: 24px;
    border: 1px solid rgb(242 240 234 / 0.22);
    border-radius: var(--raio);
  }

  .atual__rotulo {
    font-size: 0.6875rem;
    color: rgb(242 240 234 / 0.78);
  }

  .atual__nome {
    margin-top: 10px;
    font-family: var(--fonte-titulo);
    font-weight: 750;
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.25rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
  }

  .atual__onde {
    margin-top: 8px;
    color: rgb(242 240 234 / 0.78);
  }

  /* ---------- Por que agora ---------- */

  .motivos {
    margin-top: clamp(56px, 8vw, 104px);
  }

  .motivos__titulo {
    color: var(--verde-claro);
    margin-bottom: 16px;
  }

  .motivos ol {
    display: grid;
    border-top: 1px solid rgb(242 240 234 / 0.2);
  }

  .motivos li {
    display: grid;
    grid-template-columns: 2.5em 1fr;
    gap: 12px;
    padding-block: 18px;
    border-bottom: 1px solid rgb(242 240 234 / 0.2);
    font-size: 1.0625rem;
  }

  .motivos .mono {
    color: var(--verde-claro);
    padding-top: 0.2em;
  }

  /* ---------- Mapa de exposição ---------- */

  .mapa {
    margin-top: clamp(64px, 9vw, 128px);
  }

  .mapa__cabeca {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px 24px;
    margin-bottom: 20px;
  }

  .mapa__dica {
    font-size: 0.9375rem;
  }

  .mapa__foto {
    position: relative;
    margin-inline: calc(-1 * var(--margem));
  }

  .mapa__foto :global(img) {
    width: 100%;
  }

  .mapa__ponto {
    position: absolute;
    translate: -50% -50%;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 999px;
    background: var(--osso);
    color: var(--asfalto);
    font-family: var(--fonte-mono);
    font-weight: 600;
    font-size: 0.8125rem;
    box-shadow: 0 0 0 4px rgb(12 15 14 / 0.35);
    transition:
      background-color 0.2s,
      scale 0.3s var(--curva);
  }

  .mapa__ponto::after {
    content: '';
    position: absolute;
    inset: -6px;
    border-radius: inherit;
    border: 1px solid var(--osso);
    opacity: 0;
  }

  .mapa__ponto:hover,
  .mapa__ponto[aria-expanded='true'] {
    background: var(--verde-claro);
    scale: 1.12;
  }

  @media (prefers-reduced-motion: no-preference) {
    .mapa__ponto::after {
      animation: pulso 2.4s var(--curva) infinite;
      animation-play-state: paused;
    }

    :global(.mapa-visivel) .mapa__ponto::after {
      animation-play-state: running;
    }

    :global(.mapa-tocado) .mapa__ponto::after {
      animation: none;
    }
  }

  @keyframes pulso {
    0% {
      opacity: 0.8;
      scale: 0.8;
    }
    70%,
    100% {
      opacity: 0;
      scale: 1.5;
    }
  }

  .mapa__lista {
    display: grid;
    gap: 32px;
    margin-top: 24px;
  }

  .mapa__lista ol {
    display: grid;
    border-top: 1px solid rgb(242 240 234 / 0.2);
  }

  .mapa__lista li {
    display: grid;
    grid-template-columns: 32px 1fr;
    gap: 14px;
    align-items: start;
    padding: 14px 8px 14px 0;
    border-bottom: 1px solid rgb(242 240 234 / 0.2);
    transition: background-color 0.25s;
  }

  .mapa__lista li.ativo {
    background: rgb(242 240 234 / 0.07);
  }

  .mapa__lista strong {
    display: block;
    font-weight: 650;
  }

  .mapa__lista .texto-2 {
    font-size: 0.9375rem;
  }

  .mapa__num {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 999px;
    border: 1px solid rgb(242 240 234 / 0.5);
    font-family: var(--fonte-mono);
    font-size: 0.75rem;
  }

  .mapa__lista li.ativo .mapa__num {
    background: var(--verde-claro);
    border-color: var(--verde-claro);
    color: var(--asfalto);
  }

  .mapa__digital .mono {
    color: var(--verde-claro);
    margin-bottom: 12px;
    font-size: 0.75rem;
  }

  .mapa__digital ul {
    display: grid;
    border-top: 1px solid rgb(242 240 234 / 0.2);
  }

  .mapa__digital li {
    display: grid;
    grid-template-columns: none;
    gap: 2px;
    padding: 14px 0;
  }

  .mapa__digital a {
    justify-self: start;
  }

  .mapa__nota {
    margin-top: 24px;
    font-family: var(--fonte-mono);
    font-size: 0.8125rem;
    color: rgb(242 240 234 / 0.78);
  }

  /* ---------- CTA ---------- */

  .cta {
    display: grid;
    gap: 28px;
    margin-top: clamp(64px, 9vw, 128px);
    padding-top: clamp(40px, 5vw, 64px);
    border-top: 1px solid rgb(242 240 234 / 0.2);
  }

  .cta__texto {
    font-family: var(--fonte-titulo);
    font-weight: 650;
    font-size: clamp(1.375rem, 1rem + 1.5vw, 2.25rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
    max-width: 22em;
  }

  .cta__botoes {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .parcerias .botao--linha {
    border-color: rgb(242 240 234 / 0.4);
  }

  @media (min-width: 768px) {
    .mapa__foto {
      margin-inline: 0;
    }

    .mapa__foto :global(img) {
      border-radius: var(--raio);
    }

    .mapa__ponto {
      width: 36px;
      height: 36px;
    }

    .motivos ol {
      grid-template-columns: repeat(2, 1fr);
      column-gap: 48px;
    }
  }

  @media (min-width: 1024px) {
    .parcerias__topo {
      grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
      gap: 64px;
    }

    .motivos {
      display: grid;
      grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
      gap: 48px;
    }

    .mapa__lista {
      grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
      gap: 64px;
    }

    .mapa__dica {
      display: none;
    }

    .cta {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
  }
</style>
