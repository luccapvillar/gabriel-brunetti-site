---
/**
 * Trajetória: a "linha limpa" do conceito. Uma linha fina que se preenche com o scroll.
 * No desktop, a foto fica fixa ao lado e troca a cada etapa; no celular, cada etapa tem a sua.
 */
import Foto from './Foto.astro';
import Rotulo from './Rotulo.astro';

const etapas = [
  {
    quando: 'Ponto de partida',
    titulo: 'O pai e a madrasta',
    texto: 'O automobilismo entra na vida de Gabriel pelo pai e pela madrasta, que já tinha corrido de kart pela Dibo Racing.',
    foto: 'rosto',
    alt: 'Close de Gabriel sem capacete, sério, olhando para o lado.',
    credito: 'Quadro do filme',
  },
  {
    quando: 'Outubro de 2025',
    titulo: 'Primeiros treinos',
    texto: 'Gabriel começa a treinar.',
    foto: 'curva-roda-no-ar',
    alt: 'Gabriel numa curva com o kart inclinado e a roda interna fora do chão, sob céu azul.',
    credito: 'Foto: BC51 Photos',
  },
  {
    quando: 'Primeiros campeonatos',
    titulo: 'BKS e Circuito Paulista',
    texto: 'No BKS 2026, termina em 2º lugar na 2ª, na 3ª e na 5ª etapa. Também disputa o Circuito Paulista.',
    foto: 'frente-reta',
    alt: 'Gabriel vindo de frente pela reta, com carenagem verde e branca.',
    credito: 'Foto: BC51 Photos',
  },
  {
    quando: 'Temporada atual',
    titulo: 'Brasiliense e Brasileiro',
    texto: 'Na F400 Júnior, com a Dibo Racing: a mesma equipe pela qual a madrasta já correu.',
    foto: 'frente-04',
    alt: 'Gabriel à frente do kart 04, com outro kart ao fundo e grama em primeiro plano.',
    credito: '',
  },
];
---

<section class="trajetoria secao" id="trajetoria" aria-labelledby="titulo-trajetoria" data-trajetoria>
  <div class="conteiner">
    <div class="trajetoria__cabeca">
      <Rotulo numero="03" nome="Trajetória" />
      <h2 class="h2" id="titulo-trajetoria">Da influência da família ao Campeonato Brasileiro</h2>
    </div>

    <div class="trajetoria__grade">
      <div class="trajetoria__fixa" aria-hidden="true">
        <div class="trajetoria__quadro">
          {
            etapas.map((e, i) => (
              <figure class:list={['trajetoria__foto', i === 0 && 'ativa']} data-etapa-foto={i}>
                <Foto nome={e.foto} alt="" sizes="(min-width: 1024px) 45vw, 1px" />
                {e.credito && <figcaption class="mono">{e.credito}</figcaption>}
              </figure>
            ))
          }
        </div>
      </div>

      <div class="etapas" data-etapas>
        <span class="etapas__linha" aria-hidden="true"><span></span></span>
        <ol>
        {
          etapas.map((e, i) => (
            <li class="etapa" data-etapa={i}>
              <span class="etapa__marco" aria-hidden="true" />
              <p class="etapa__quando mono">
                <span class="etapa__num">{String(i + 1).padStart(2, '0')}</span> {e.quando}
              </p>
              <h3 class="etapa__titulo h3">{e.titulo}</h3>
              <p class="etapa__texto texto-2">{e.texto}</p>
              <figure class="etapa__foto">
                <Foto nome={e.foto} alt={e.alt} sizes="(min-width: 1024px) 1px, 100vw" />
                {e.credito && <figcaption class="mono texto-2">{e.credito}</figcaption>}
              </figure>
            </li>
          ))
        }
        <li class="etapa etapa--proxima">
          <span class="etapa__marco" aria-hidden="true" />
          <a class="etapa__proxima" href="#proximo-passo">
            <span class="mono">Depois</span>
            <span class="h3">Próximo passo <span class="seta" aria-hidden="true">→</span></span>
          </a>
        </li>
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .trajetoria__cabeca {
    max-width: 48rem;
    margin-bottom: clamp(48px, 7vw, 112px);
  }

  .trajetoria__grade {
    display: grid;
    gap: 64px;
  }

  .trajetoria__fixa {
    display: none;
  }

  /* ---------- Etapas e a linha ---------- */

  .etapas {
    position: relative;
    padding-left: 40px;
  }

  .etapas__linha {
    position: absolute;
    left: 7px;
    top: 10px;
    bottom: 34px;
    width: 1px;
    background: var(--linha-clara);
  }

  .etapas__linha span {
    position: absolute;
    inset: 0;
    background: var(--verde-claro);
    transform-origin: top;
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .etapas__linha span {
        animation: preenche linear both;
        animation-timeline: --etapas;
        animation-range: cover 30% cover 75%;
      }

      .etapas {
        view-timeline: --etapas block;
      }
    }
  }

  @keyframes preenche {
    from {
      transform: scaleY(0);
    }
  }

  .etapa {
    position: relative;
    padding-bottom: clamp(56px, 8vw, 120px);
  }

  .etapa__marco {
    position: absolute;
    left: -40px;
    top: 4px;
    width: 15px;
    height: 15px;
    border-radius: 999px;
    background: var(--asfalto);
    border: 1px solid var(--texto-claro-2);
    transition: background-color 0.4s, border-color 0.4s;
  }

  .etapa.atual .etapa__marco,
  .etapa--proxima .etapa__marco {
    background: var(--verde-claro);
    border-color: var(--verde-claro);
  }

  .etapa__quando {
    color: var(--texto-claro-2);
    margin-bottom: 14px;
  }

  .etapa__num {
    color: var(--verde-claro);
    margin-right: 8px;
  }

  .etapa__titulo {
    font-size: clamp(1.625rem, 1.2rem + 1.8vw, 2.75rem);
    margin-bottom: 14px;
  }

  .etapa__texto {
    max-width: 30em;
    font-size: 1.0625rem;
  }

  .etapa__foto {
    margin-top: 24px;
  }

  .etapa__foto :global(img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: var(--raio);
  }

  .etapa__foto figcaption {
    margin-top: 8px;
    font-size: 0.6875rem;
  }

  .etapa--proxima {
    padding-bottom: 0;
  }

  .etapa__proxima {
    display: inline-grid;
    gap: 10px;
    text-decoration: none;
  }

  .etapa__proxima .mono {
    color: var(--verde-claro);
  }

  .etapa__proxima .h3 {
    font-size: clamp(1.625rem, 1.2rem + 1.8vw, 2.75rem);
  }

  /* ---------- Desktop: foto fixa que troca a cada etapa ---------- */

  @media (min-width: 1024px) {
    .trajetoria__grade {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      gap: clamp(48px, 6vw, 112px);
    }

    .trajetoria__fixa {
      display: block;
    }

    .trajetoria__quadro {
      position: sticky;
      top: calc(var(--cabecalho) + 6vh);
      aspect-ratio: 4 / 5;
      max-height: calc(100svh - var(--cabecalho) - 12vh);
      width: 100%;
    }

    .trajetoria__foto {
      position: absolute;
      inset: 0;
      opacity: 0;
      transition:
        opacity 0.7s var(--curva),
        scale 1.2s var(--curva);
      scale: 1.03;
    }

    .trajetoria__foto.ativa {
      opacity: 1;
      scale: 1;
    }

    .trajetoria__foto :global(picture),
    .trajetoria__foto :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: var(--raio);
    }

    .trajetoria__foto figcaption {
      position: absolute;
      left: 16px;
      bottom: 14px;
      font-size: 0.6875rem;
      color: var(--osso);
      text-shadow: 0 1px 8px rgb(0 0 0 / 0.6);
    }

    .etapa {
      min-height: 52svh;
    }

    .etapa--proxima {
      min-height: 0;
    }

    .etapa__foto {
      display: none;
    }
  }
</style>
