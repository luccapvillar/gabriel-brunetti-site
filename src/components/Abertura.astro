---
/**
 * Abertura: foto → "33" gigante → recorte do piloto por cima.
 * O número fica entre a foto e o recorte, então parece estar atrás do Gabriel,
 * com o capacete entre os dois "3". O recorte cobre só a faixa do capacete e do tronco
 * e é posicionado sobre a foto com as mesmas coordenadas (scripts/coordenadas-abertura.mjs).
 * No celular, foto e recorte usam o enquadramento 3:4 centrado no capacete.
 */
import { imagem } from '../data/imagens';
import { IDADE } from '../data/gabriel';
import { textoEmCurvas } from '../../scripts/texto-em-curvas.mjs';
import {
  FOTO,
  CAPACETE,
  CELULAR,
  NUMERO_DESKTOP,
  NUMERO_CELULAR,
  RECORTE_DESKTOP,
  RECORTE_CELULAR,
} from '../../scripts/coordenadas-abertura.mjs';

const foto = await imagem('a-frente');
const fotoCel = await imagem('a-frente-celular');
const recorte = await imagem('a-frente-recorte-topo');
const recorteCel = await imagem('a-frente-recorte-topo-celular');

const numero = await textoEmCurvas('33', { peso: 900, tamanho: 100 });
const c = numero.caixa;
const viewBox = `${c.x.toFixed(2)} ${c.y.toFixed(2)} ${c.largura.toFixed(2)} ${c.altura.toFixed(2)}`;

// Tudo em frações do palco (o palco tem a proporção da imagem usada em cada tamanho de tela).
const fr = (v: number, total: number) => +(v / total).toFixed(5);
const quadro = {
  d: { x: 0, y: 0, w: FOTO.largura, h: FOTO.altura },
  c: { x: CELULAR.left, y: CELULAR.top, w: CELULAR.width, h: CELULAR.height },
};
const variaveis: Record<string, number> = {};
for (const [k, q, n, r] of [
  ['d', quadro.d, NUMERO_DESKTOP, RECORTE_DESKTOP],
  ['c', quadro.c, NUMERO_CELULAR, RECORTE_CELULAR],
] as const) {
  variaveis[`--${k}-largura`] = fr(n.largura, q.w);
  variaveis[`--${k}-centro`] = fr(CAPACETE.centroX - q.x, q.w);
  variaveis[`--${k}-topo`] = fr(n.topo - q.y, q.h);
  variaveis[`--${k}-r-x`] = fr(r.left - q.x, q.w);
  variaveis[`--${k}-r-y`] = fr(r.top - q.y, q.h);
  variaveis[`--${k}-r-w`] = fr(r.width, q.w);
  variaveis[`--${k}-r-h`] = fr(r.height, q.h);
}
// Ponto da foto que fica no centro do painel quando ele corta as laterais
variaveis['--d-foco'] = 0.54;
variaveis['--c-foco'] = 0.5;
const estilo = Object.entries(variaveis)
  .map(([k, v]) => `${k}:${v}`)
  .join(';');

const SIZES_DESKTOP = '(min-width: 1024px) 70vw, 100vw';
const SIZES_RECORTE = '(min-width: 1024px) 44vw, 100vw';
const DESKTOP = '(min-width: 1024px)';

const dados = [
  { rotulo: 'Categoria', valor: 'Kart F400 Júnior' },
  { rotulo: 'Temporada', valor: 'Brasiliense e Brasileiro' },
  { rotulo: 'Destaque', valor: '3× 2º em etapas do BKS 2026' },
  { rotulo: 'Objetivo', valor: 'Stock Car' },
];
---

<section class="abertura" id="topo" aria-labelledby="titulo-abertura" style={estilo} data-abertura>
  <div class="abertura__painel">
    <div class="palco" data-palco>
      <picture class="camada camada--foto">
        <source media={DESKTOP} type="image/avif" srcset={foto.srcset('avif')} sizes={SIZES_DESKTOP} width={foto.largura} height={foto.altura} />
        <source media={DESKTOP} type="image/webp" srcset={foto.srcset('webp')} sizes={SIZES_DESKTOP} width={foto.largura} height={foto.altura} />
        <source type="image/avif" srcset={fotoCel.srcset('avif')} sizes="100vw" width={fotoCel.largura} height={fotoCel.altura} />
        <img
          src={fotoCel.src(750)}
          srcset={fotoCel.srcset('webp')}
          sizes="100vw"
          width={fotoCel.largura}
          height={fotoCel.altura}
          alt="Gabriel Brunetti pilotando o kart número 33, verde e branco, à frente de um adversário."
          fetchpriority="high"
          decoding="sync"
        />
      </picture>

      <div class="numero" aria-hidden="true" data-numero>
        <svg viewBox={viewBox} preserveAspectRatio="xMidYMid meet" focusable="false"><path d={numero.d} /></svg>
      </div>

      <picture class="camada camada--recorte" aria-hidden="true">
        <source media={DESKTOP} type="image/avif" srcset={recorte.srcset('avif')} sizes={SIZES_RECORTE} width={recorte.largura} height={recorte.altura} />
        <source media={DESKTOP} type="image/webp" srcset={recorte.srcset('webp')} sizes={SIZES_RECORTE} width={recorte.largura} height={recorte.altura} />
        <source type="image/avif" srcset={recorteCel.srcset('avif')} sizes="100vw" width={recorteCel.largura} height={recorteCel.altura} />
        <img
          src={recorteCel.src(750)}
          srcset={recorteCel.srcset('webp')}
          sizes="100vw"
          width={recorteCel.largura}
          height={recorteCel.altura}
          alt=""
          fetchpriority="low"
          data-recorte
        />
      </picture>
    </div>
  </div>

  <div class="abertura__texto">
    <p class="mono abertura__sobre">Piloto · Kart F400 Júnior · Nº 33</p>
    <h1 class="abertura__titulo titulo" id="titulo-abertura">
      <span class="linha"><span>Gabriel</span></span>
      <span class="linha"><span>Brunetti</span></span>
    </h1>
    <p class="abertura__lead lead">
      <span data-idade>{IDADE}</span> anos, de Valparaíso de Goiás. Corre na F400 Júnior com a equipe Dibo Racing, disputa o Campeonato Brasiliense e o
      Campeonato Brasileiro e tem um objetivo de longo prazo: a Stock Car.
    </p>
    <div class="abertura__botoes">
      <a class="botao" href="#trajetoria">Ver a trajetória <span class="seta" aria-hidden="true">→</span></a>
      <a class="botao botao--linha" href="#parcerias">Parcerias e patrocínio</a>
    </div>
  </div>

  <dl class="abertura__dados">
    {
      dados.map((d) => (
        <div>
          <dt class="mono">{d.rotulo}</dt>
          <dd>{d.valor}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .abertura {
    --px: 0;
    --py: 0;
    position: relative;
    display: grid;
    background: var(--asfalto);
  }

  /* ---------- Painel da foto (palco com as 3 camadas) ---------- */

  .abertura__painel {
    --ar: 0.75; /* proporção do palco (largura / altura) */
    --largura: var(--c-largura);
    --centro: var(--c-centro);
    --topo: var(--c-topo);
    --foco: var(--c-foco);
    --r-x: var(--c-r-x);
    --r-y: var(--c-r-y);
    --r-w: var(--c-r-w);
    --r-h: var(--c-r-h);
    position: relative;
    overflow: hidden;
    container-type: size;
    aspect-ratio: 3 / 4;
    max-height: 80svh;
    width: 100%;
    margin-top: var(--cabecalho);
    background: var(--asfalto-2);
  }

  .palco {
    /* "cover" feito à mão para que o número continue preso às coordenadas da foto */
    --w: max(100cqw, 100cqh * var(--ar));
    --h: calc(var(--w) / var(--ar));
    position: absolute;
    width: var(--w);
    height: var(--h);
    left: clamp(100cqw - var(--w), 50cqw - var(--foco) * var(--w), 0px);
    top: clamp(100cqh - var(--h), 50cqh - 0.42 * var(--h), 0px);
    translate: calc(var(--px) * -6px) calc(var(--py) * -4px);
    transition: translate 0.6s var(--curva);
  }

  .camada,
  .camada img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .camada img {
    object-fit: cover;
  }

  .camada--recorte {
    inset: auto;
    left: calc(var(--r-x) * 100%);
    top: calc(var(--r-y) * 100%);
    width: calc(var(--r-w) * 100%);
    height: calc(var(--r-h) * 100%);
  }

  /* Com JS, o número só entra quando o recorte do piloto já carregou (senão cobriria o capacete) */
  :global(.js) .numero {
    visibility: hidden;
  }

  :global(.js) .pronta .numero {
    visibility: visible;
  }

  /* Só um degradê no topo, para o cabeçalho. Ele termina antes da borda de baixo do recorte
     (58% da altura): se a foto fosse escurecida por inteiro, a borda do recorte apareceria como uma linha. */
  .camada--foto::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(12 15 14 / 0.4), rgb(12 15 14 / 0) 30%);
  }

  .numero {
    position: absolute;
    width: calc(var(--largura) * 100%);
    left: calc(var(--centro) * 100%);
    top: calc(var(--topo) * 100%);
    translate: calc(-50% + var(--px) * 10px) calc(var(--py) * 6px);
    transition: translate 0.6s var(--curva);
  }

  .numero svg {
    width: 100%;
    height: auto;
    fill: var(--osso);
    overflow: visible;
  }

  /* ---------- Texto ---------- */

  .abertura__texto {
    padding: clamp(28px, 6vw, 48px) var(--margem) clamp(40px, 8vw, 64px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .abertura__sobre {
    color: var(--verde-claro);
    margin-bottom: clamp(16px, 2.5vw, 28px);
  }

  .abertura__titulo {
    font-size: clamp(3rem, 14.5vw, 7.25rem);
    font-weight: 820;
    text-transform: uppercase;
    line-height: 0.9;
    letter-spacing: -0.035em;
  }

  .linha {
    display: block;
    overflow: hidden;
    padding-bottom: 0.04em;
  }

  .linha > span {
    display: block;
  }

  .abertura__lead {
    max-width: 34em;
    margin-top: clamp(20px, 3vw, 32px);
    color: var(--texto-claro-2);
  }

  .abertura__botoes {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: clamp(24px, 4vw, 40px);
  }

  /* ---------- Faixa de dados ---------- */

  .abertura__dados {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid var(--linha-clara);
  }

  .abertura__dados > div {
    padding: 18px var(--margem) 20px;
    border-bottom: 1px solid var(--linha-clara);
  }

  .abertura__dados > div:nth-child(odd) {
    border-right: 1px solid var(--linha-clara);
  }

  .abertura__dados dt {
    color: var(--texto-claro-2);
    font-size: 0.75rem;
    margin-bottom: 4px;
  }

  .abertura__dados dd {
    font-family: var(--fonte-titulo);
    font-weight: 650;
    font-size: clamp(0.9375rem, 0.85rem + 0.4vw, 1.125rem);
    line-height: 1.25;
  }

  /* Tablet em pé: a foto não precisa ocupar a altura toda */
  @media (min-width: 640px) and (max-width: 1023px) {
    .abertura__painel {
      aspect-ratio: 4 / 4;
      max-height: 72svh;
    }
  }

  /* ---------- Desktop: tela dividida ---------- */

  @media (min-width: 1024px) {
    .abertura {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      grid-template-rows: 1fr auto;
      min-height: max(640px, 100svh);
    }

    .abertura__painel {
      --ar: 1.5;
      --largura: var(--d-largura);
      --centro: var(--d-centro);
      --topo: var(--d-topo);
      --foco: var(--d-foco);
      --r-x: var(--d-r-x);
      --r-y: var(--d-r-y);
      --r-w: var(--d-r-w);
      --r-h: var(--d-r-h);
      grid-column: 2;
      grid-row: 1;
      aspect-ratio: auto;
      max-height: none;
      height: 100%;
      margin-top: 0;
    }

    .abertura__texto {
      grid-column: 1;
      grid-row: 1;
      justify-content: center;
      padding-top: calc(var(--cabecalho) + 40px);
      padding-bottom: 56px;
      padding-right: clamp(24px, 3vw, 56px);
    }

    .abertura__titulo {
      font-size: clamp(3.5rem, 6.6vw, 8.5rem);
    }

    .abertura__dados {
      grid-column: 1 / -1;
      grid-row: 2;
      grid-template-columns: repeat(4, 1fr);
    }

    .abertura__dados > div {
      border-bottom: 0;
      border-right: 1px solid var(--linha-clara);
      padding-block: 22px 24px;
    }

    .abertura__dados > div:last-child {
      border-right: 0;
    }
  }

  /* ---------- Movimento de entrada e de scroll ---------- */

  @media (prefers-reduced-motion: no-preference) {
    .palco {
      animation: assenta 1.6s var(--curva) both;
    }

    :global(html:not(.js)) .numero svg,
    .pronta .numero svg {
      animation: sobe 1.2s 0.1s var(--curva) both;
    }

    .linha > span {
      animation: mascara 1s var(--curva) both;
    }

    .linha + .linha > span {
      animation-delay: 0.08s;
    }

    .abertura__sobre,
    .abertura__lead,
    .abertura__botoes {
      animation: aparece 0.9s 0.35s var(--curva) both;
    }

    /* Ao rolar, foto e recorte descem juntos (palco) e o número desce mais: camadas em velocidades diferentes */
    @supports (animation-timeline: view()) {
      .palco {
        animation:
          assenta 1.6s var(--curva) both,
          desce-palco linear both;
        animation-timeline: auto, view();
        animation-range: normal, exit 0% exit 100%;
      }

      .numero {
        animation: desce-numero linear both;
        animation-timeline: view();
        animation-range: exit 0% exit 100%;
      }
    }
  }

  @keyframes assenta {
    from {
      scale: 1.06;
    }
  }

  @keyframes sobe {
    from {
      transform: translateY(22%);
      opacity: 0;
    }
  }

  @keyframes mascara {
    from {
      transform: translateY(105%);
    }
  }

  @keyframes aparece {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  @keyframes desce-palco {
    to {
      transform: translateY(12%);
    }
  }

  @keyframes desce-numero {
    to {
      transform: translateY(22%);
    }
  }
</style>
