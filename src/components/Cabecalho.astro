---
import { contato } from '../data/gabriel';

const links = [
  { href: '#perfil', texto: 'Perfil' },
  { href: '#trajetoria', texto: 'Trajetória' },
  { href: '#resultados', texto: 'Resultados' },
  { href: '#preparacao', texto: 'Preparação' },
  { href: '#filme', texto: 'Filme' },
  { href: '#parcerias', texto: 'Parcerias' },
];
---

<header class="cabecalho" data-cabecalho>
  <div class="cabecalho__barra">
    <a class="marca" href="#topo">
      <span class="placa">33</span>
      <span class="marca__nome">Gabriel Brunetti</span>
    </a>

    <nav class="nav" aria-label="Seções">
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.texto}</a></li>)}
      </ul>
    </nav>

    <a class="botao cabecalho__cta" href="#contato">Contato e patrocínio</a>

    <button class="menu-botao" type="button" aria-expanded="false" aria-controls="menu" data-menu-botao>
      <span class="visualmente-oculto" data-menu-rotulo>Abrir menu</span>
      <span class="menu-botao__linhas" aria-hidden="true"></span>
    </button>
  </div>

  <div class="menu" id="menu" data-menu hidden>
    <nav aria-label="Menu">
      <ol class="menu__links">
        {links.map((l, i) => (
          <li>
            <a href={l.href}>
              <span class="mono">{String(i + 1).padStart(2, '0')}</span>
              {l.texto}
            </a>
          </li>
        ))}
        <li>
          <a href="#contato">
            <span class="mono">{String(links.length + 1).padStart(2, '0')}</span>
            Contato
          </a>
        </li>
      </ol>
    </nav>
    <div class="menu__contato">
      <p class="mono texto-2">Patrocínio, imprensa e parcerias</p>
      <a href={`mailto:${contato.email}`}>{contato.email}</a>
      <a href={contato.whatsapp} rel="noopener" target="_blank">WhatsApp {contato.telefone}</a>
      <a href={contato.instagramUrl} rel="noopener" target="_blank">Instagram {contato.instagram}</a>
    </div>
  </div>
</header>

<style>
  .cabecalho {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    transition: transform 0.45s var(--curva);
  }

  .cabecalho__barra {
    display: flex;
    align-items: center;
    gap: 24px;
    height: var(--cabecalho);
    padding-inline: var(--margem);
    position: relative;
    z-index: 2;
    transition:
      background-color 0.35s var(--curva),
      border-color 0.35s var(--curva);
    border-bottom: 1px solid transparent;
  }

  /* Fundo só depois que a abertura sai da tela */
  :global(.cabecalho.solido) .cabecalho__barra,
  :global(.cabecalho.aberto) .cabecalho__barra {
    background: rgb(12 15 14 / 0.92);
    border-bottom-color: var(--linha-clara);
  }

  @supports (backdrop-filter: blur(1px)) {
    :global(.cabecalho.solido) .cabecalho__barra {
      background: rgb(12 15 14 / 0.78);
      backdrop-filter: blur(14px) saturate(1.2);
    }
  }

  :global(.cabecalho.escondido) {
    transform: translateY(-100%);
  }

  .marca {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    margin-right: auto;
  }

  .marca__nome {
    font-family: var(--fonte-titulo);
    font-weight: 750;
    font-size: 0.9375rem;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }

  .nav ul {
    display: flex;
    gap: clamp(16px, 2vw, 32px);
  }

  .nav a {
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--texto-claro-2);
    transition: color 0.2s;
    padding-block: 8px;
  }

  .nav a:hover,
  .nav a[aria-current='true'] {
    color: var(--osso);
  }

  .cabecalho__cta {
    min-height: 40px;
    padding: 8px 18px;
    font-size: 0.9375rem;
  }

  .menu-botao {
    display: none;
    width: 48px;
    height: 48px;
    margin-right: -12px;
    place-items: center;
  }

  .menu-botao__linhas,
  .menu-botao__linhas::before {
    display: block;
    width: 22px;
    height: 2px;
    background: currentColor;
    transition: transform 0.3s var(--curva);
  }

  .menu-botao__linhas {
    position: relative;
    transform: translateY(-4px);
  }

  .menu-botao__linhas::before {
    content: '';
    position: absolute;
    top: 8px;
  }

  .menu-botao[aria-expanded='true'] .menu-botao__linhas {
    transform: rotate(45deg);
  }

  .menu-botao[aria-expanded='true'] .menu-botao__linhas::before {
    transform: translateY(-8px) rotate(-90deg);
  }

  .menu {
    position: fixed;
    inset: 0;
    z-index: 1;
    padding: calc(var(--cabecalho) + 24px) var(--margem) max(32px, env(safe-area-inset-bottom));
    background: var(--asfalto);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 40px;
    overflow-y: auto;
  }

  .menu[hidden] {
    display: none;
  }

  .menu__links a {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding-block: 10px;
    font-family: var(--fonte-titulo);
    font-weight: 750;
    font-size: clamp(1.75rem, 8vw, 2.5rem);
    line-height: 1.1;
    text-decoration: none;
    border-bottom: 1px solid var(--linha-clara);
  }

  .menu__links .mono {
    color: var(--verde-claro);
    min-width: 2.2em;
  }

  .menu__contato {
    display: grid;
    gap: 10px;
    font-size: 1.0625rem;
  }

  .menu__contato a {
    text-decoration: none;
    padding-block: 4px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .menu:not([hidden]) .menu__links li {
      animation: entra-menu 0.5s var(--curva) both;
    }

    .menu__links li:nth-child(2) { animation-delay: 0.03s; }
    .menu__links li:nth-child(3) { animation-delay: 0.06s; }
    .menu__links li:nth-child(4) { animation-delay: 0.09s; }
    .menu__links li:nth-child(5) { animation-delay: 0.12s; }
    .menu__links li:nth-child(6) { animation-delay: 0.15s; }
    .menu__links li:nth-child(7) { animation-delay: 0.18s; }
  }

  @keyframes entra-menu {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }

  @media (max-width: 1099px) {
    .nav,
    .cabecalho__cta {
      display: none;
    }

    .menu-botao {
      display: grid;
    }
  }

  @media (min-width: 1100px) {
    .menu {
      display: none !important;
    }
  }
</style>
